<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:components="clr-namespace:NetLpr.Desktop.Components"
        xmlns:vm="using:NetLpr.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="800"
        x:Class="NetLpr.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/logo.ico"
        Title="Net Lpr"
        MinWidth="800"
        MinHeight="450">

	<Design.DataContext>
		<vm:MainWindowViewModel/>
	</Design.DataContext>

	<SplitView IsPaneOpen="{Binding IsPaneOpen}"
               OpenPaneLength="218"
               CompactPaneLength="60"
               DisplayMode="CompactInline"
               PanePlacement="Left">

		<SplitView.Pane>
			<Border Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="0,0,1,0">
				<Grid RowDefinitions="Auto,*,Auto">
					<Grid Grid.Row="0"
                          ColumnDefinitions="Auto,*"
                          Margin="12,14,12,18">
						<Button Classes="icon"
								Command="{Binding TriggerPaneCommand}">
							<Border Width="34"
									Height="34"
									CornerRadius="9"
									Background="{StaticResource AccentBrush}"
									HorizontalAlignment="Left"
									VerticalAlignment="Center">
								<PathIcon Data="{StaticResource logoIcon}"
															  Width="19"
															  Height="19"
															  Foreground="White"/>
							</Border>
						
						</Button>

						<StackPanel Grid.Column="1"
                                    Margin="11,0,0,0"
                                    VerticalAlignment="Center">

							<TextBlock Text="NET"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       LetterSpacing="1.2"/>

							<TextBlock Text="LPR"
                                       FontSize="10"
                                       Opacity="0.5"
                                       LetterSpacing="1.5"/>
						</StackPanel>
					</Grid>

					<Grid Grid.Row="1"
                          RowDefinitions="*">
						<ListBox Grid.Row="1"
                                 Margin="8,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemsSource="{Binding Items}"
                                 SelectedItem="{Binding SelectedItem}">

							<ListBox.Styles>
								<Style Selector="ListBoxItem">
									<Setter Property="Padding" Value="10,9"/>
									<Setter Property="Margin" Value="0,2"/>
									<Setter Property="CornerRadius" Value="7"/>
									<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
								</Style>

								<Style Selector="ListBoxItem:pointerover">
									<Setter Property="Background"
                                            Value="{DynamicResource ThemeControlHighlightMidBrush}"/>
								</Style>

								<Style Selector="ListBoxItem:selected">
									<Setter Property="Background"
                                            Value="{StaticResource AccentBrush}"/>
									<Setter Property="Foreground"
                                            Value="White"/>
								</Style>
							</ListBox.Styles>

							<ListBox.ItemTemplate>
								<DataTemplate DataType="{x:Type vm:ListItemTemplate}">
									<Grid ColumnDefinitions="24,*">

										<PathIcon Data="{Binding Icon}"
                                                  Width="18"
                                                  Height="18"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"/>

										<TextBlock Grid.Column="1"
                                                   Text="{Binding Label}"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
									</Grid>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</Grid>
					<Border Grid.Row="2"
                            Margin="8,12,8,10"
                            Padding="8"
                            CornerRadius="9"
                            Background="{DynamicResource ThemeBackgroundBrush}"
                            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                            BorderThickness="1">

						<Grid ColumnDefinitions="Auto,Auto">

							<Button 
                                    Command="{Binding ToggleThemeCommand}"
                                    Width="34"
                                    Height="34">

								<PathIcon Data="{StaticResource logoIcon}"
                                          Width="17"
                                          Height="17"/>
							</Button>

							<ComboBox Grid.Column="1"
                                      SelectedIndex="{Binding LanguageIndex}"
                                      Margin="6,0,0,0"
                                      VerticalAlignment="Center"
                                      Background="Transparent"
                                      BorderThickness="0">

								<ComboBoxItem>
									<StackPanel Orientation="Horizontal"
                                                Spacing="8">
										<components:TrFlagIcon/>
										<TextBlock Text="Türkçe"
                                                   VerticalAlignment="Center"/>
									</StackPanel>
								</ComboBoxItem>

								<ComboBoxItem>
									<StackPanel Orientation="Horizontal"
                                                Spacing="8">
										<components:UsFlagIcon/>
										<TextBlock Text="English"
                                                   VerticalAlignment="Center"/>
									</StackPanel>
								</ComboBoxItem>

								<ComboBoxItem>
									<StackPanel Orientation="Horizontal"
                                                Spacing="8">
										<components:AzFlagIcon/>
										<TextBlock Text="Azərbaycan"
                                                   VerticalAlignment="Center"/>
									</StackPanel>
								</ComboBoxItem>

							</ComboBox>
						</Grid>
					</Border>

				</Grid>
			</Border>
		</SplitView.Pane>

		<SplitView.Content>
			<Grid Background="{DynamicResource ThemeBackgroundBrush}">
				<ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
					<Border Margin="28,24,28,28">
						<TransitioningContentControl Content="{Binding CurrentPage}"/>
					</Border>
				</ScrollViewer>
			</Grid>
		</SplitView.Content>

	</SplitView>

</Window>
