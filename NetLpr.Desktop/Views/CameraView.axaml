
<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="using:NetLpr.Desktop.ViewModels" xmlns:views="using:NetLpr.Desktop.Views" x:DataType="vm:CameraViewModel" x:Class="NetLpr.Desktop.Views.CameraView" mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="500">
	<Border Margin="0,0,0,18" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="14">
		<Grid RowDefinitions="Auto,Auto,Auto">

			<Grid Grid.Row="0" Margin="18,15,18,12" ColumnDefinitions="*,Auto">
				<StackPanel Spacing="3">
					<TextBlock Text="CAMERA" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
					<TextBlock Text="{Binding RtspSourceMessage}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
				</StackPanel>
			</Grid>

			<Grid Grid.Row="1" Margin="18,0,18,16" ColumnDefinitions="2*,2*,1.05*" >

				<Border Grid.Column="0" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="11" ClipToBounds="True">
					<Grid>
						<Image Source="{Binding CurrentFrame}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>

						<Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="8,4" CornerRadius="6" Background="{DynamicResource AppSurfaceRaisedBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
							<TextBlock Text="LIVE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
						</Border>
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Spacing="6">
							<Button Classes="icon warning" Command="{Binding EditLineCommand}" ToolTip.Tip="Edit">
								<PathIcon Width="17" Data="{StaticResource editIcon}"/>
							</Button>
							<Button Classes="icon accent" IsVisible="{Binding !VideoIsShowing}" Command="{Binding VideoShowingCommand}" ToolTip.Tip="Show">
								<PathIcon Width="17" Data="{StaticResource eyeIcon}"/>
							</Button>
							<Button Classes="icon accent " IsVisible="{Binding VideoIsShowing}" Command="{Binding VideoShowingCommand}" ToolTip.Tip="Hide">
								<PathIcon Width="17" Data="{StaticResource eyeCloseIcon}"/>
							</Button>
							<Button Classes="icon danger" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove">
								<PathIcon Width="17" Data="{StaticResource removeIcon}"/>
							</Button>
						</StackPanel>
					</Grid>
				</Border>

				<Border Grid.Column="1" Margin="2 0 0 0" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="11" ClipToBounds="True">
					<Grid>
						<Image Source="{Binding ResultImage}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
						<Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="8,4" CornerRadius="6" Background="{DynamicResource AppSurfaceRaisedBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
							<TextBlock Text="RECOGNITION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
						</Border>
					</Grid>
				</Border>
				<Border Grid.Column="2" Margin="2 0 0 0" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="11">
					<views:TrackedInfoResultView DataContext="{Binding TrackedInfoResult}"/>

				</Border>
			</Grid>

			<Expander HorizontalAlignment="Stretch" Grid.Row="3" Margin="18,0,18,18" IsExpanded="False">
				<Expander.Header>
					<Grid ColumnDefinitions="*,Auto">
						<TextBlock Text="{Binding Labels.Results}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
						<TextBlock Grid.Column="1" Text="VIEW" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
					</Grid>
				</Expander.Header>
				<Border Padding="12" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="0,0,10,10">
					<ItemsControl x:Name="ResultItem" ItemsSource="{Binding Results}">
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="{x:Type vm:TrackedInfoResultViewModel}">
								<ContentControl Content="{Binding}">
									<ContentControl.ContentTemplate>
										<DataTemplate>
											<views:TrackedInfoResultView/>
										</DataTemplate>
									</ContentControl.ContentTemplate>
								</ContentControl>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</Border>
			</Expander>
		</Grid>
	</Border>
</UserControl>